{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded provenance analyst workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["case", "claim", "operator", "controller", "sources", "consumers", "correction", "commands", "command_budget"],
  "properties": {
    "case": {"type": "object"},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "source", "root", "uncertainty"],
      "properties": {
        "text": {"type": "string", "pattern": "\\S"},
        "source": {"type": "string", "pattern": "\\S"},
        "root": {"type": "string", "pattern": "\\S"},
        "uncertainty": {"type": "string", "pattern": "\\S"}
      }
    },
    "operator": {"type": "string", "pattern": "\\S"},
    "controller": {"enum": ["agent", "operator"]},
    "command_budget": {"type": "integer", "minimum": 1, "maximum": 1000},
    "sources": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "root"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "description": {"type": "string", "pattern": "\\S"},
          "root": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "consumers": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$", "not": {"const": "evaluation"}}
    },
    "correction": {
      "type": "object", "additionalProperties": false, "required": ["text", "reason"],
      "properties": {
        "text": {"type": "string", "pattern": "\\S"},
        "reason": {"type": "string", "pattern": "\\S"}
      }
    },
    "commands": {
      "type": "array", "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false, "required": ["tick", "operation", "source_id"],
            "properties": {
              "tick": {"type": "integer", "minimum": 0},
              "operation": {"const": "observe"},
              "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
            }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["tick", "operation"],
            "properties": {
              "tick": {"type": "integer", "minimum": 0},
              "operation": {"enum": ["use", "pause", "resume", "correct", "finish"]}
            }
          }
        ]
      }
    }
  }
}
