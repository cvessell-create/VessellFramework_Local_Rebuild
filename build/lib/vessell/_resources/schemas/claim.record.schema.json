{
  "$defs": {
    "ClaimRecord": {
      "additionalProperties": false,
      "properties": {
        "causal_path": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "causal_predecessor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "corroboration": {
          "items": {
            "$ref": "#/$defs/Corroboration"
          },
          "type": "array"
        },
        "disavowal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Disavowal"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "REPORT",
            "ASSUMPTION",
            "JUDGMENT"
          ],
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ClaimSource"
        },
        "status": {
          "enum": [
            "UNVERIFIED",
            "CORROBORATED",
            "DISAVOWED",
            "SUPERSEDED"
          ]
        },
        "subject": {
          "type": "string"
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        },
        "valid_until": {
          "type": "string"
        },
        "waiver": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimWaiver"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "text",
        "subject",
        "source",
        "status",
        "corroboration",
        "waiver",
        "disavowal",
        "supersedes",
        "superseded_by",
        "note",
        "kind",
        "uncertainty",
        "valid_until",
        "causal_path",
        "causal_predecessor_id"
      ],
      "title": "ClaimRecord",
      "type": "object"
    },
    "ClaimSource": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "is_official_record": {
          "type": "boolean"
        },
        "is_ai_generated": {
          "type": "boolean"
        },
        "recorded_at": {
          "type": "string"
        },
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "enum": [
            "SOURCE-ESTABLISHED",
            "FRAMEWORK SYNTHESIS",
            "WORKING HYPOTHESIS",
            "ILLUSTRATIVE"
          ],
          "type": "string"
        }
      },
      "required": [
        "description",
        "tier",
        "recorded_at",
        "root",
        "is_official_record",
        "is_ai_generated"
      ],
      "title": "ClaimSource",
      "type": "object"
    },
    "ClaimWaiver": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string"
        },
        "waived_at": {
          "type": "string"
        },
        "waived_by": {
          "type": "string"
        }
      },
      "required": [
        "waived_by",
        "reason",
        "waived_at"
      ],
      "title": "ClaimWaiver",
      "type": "object"
    },
    "Corroboration": {
      "additionalProperties": false,
      "properties": {
        "is_official_record": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "observed_at": {
          "type": "string"
        },
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "SOURCE-ESTABLISHED",
            "FRAMEWORK SYNTHESIS",
            "WORKING HYPOTHESIS",
            "ILLUSTRATIVE"
          ],
          "type": "string"
        }
      },
      "required": [
        "source",
        "tier",
        "root",
        "observed_at",
        "is_official_record",
        "note"
      ],
      "title": "Corroboration",
      "type": "object"
    },
    "Dependent": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string"
        },
        "confirmed_at": {
          "type": "string"
        },
        "confirmed_correction": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivered_correction": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": "string"
        },
        "noted_at": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PENDING",
            "UPDATED"
          ],
          "type": "string"
        },
        "via": {
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "location",
        "noted_at",
        "status",
        "confirmed_at",
        "via",
        "delivered_correction",
        "confirmed_correction"
      ],
      "title": "Dependent",
      "type": "object"
    },
    "Disavowal": {
      "additionalProperties": false,
      "properties": {
        "corrected_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "disavowed_at": {
          "type": "string"
        },
        "disavowed_by": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "disavowed_by",
        "reason",
        "disavowed_at",
        "corrected_text"
      ],
      "title": "Disavowal",
      "type": "object"
    }
  },
  "$id": "https://vessellframework.local/schemas/claim.record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Auditable claim-lifecycle records produced by vessell.provenance: provenance-tagged claims (intake -> corroboration -> gating -> disavowal) with correction-propagation dependents. Every claim carries its source tier, ICD 203 kind (report/assumption/judgment), uncertainty expression, and revalidation date; disavowed records are kept, never deleted.",
  "properties": {
    "claim": {
      "$ref": "#/$defs/ClaimRecord"
    },
    "dependent": {
      "$ref": "#/$defs/Dependent"
    },
    "record_type": {
      "enum": [
        "claim",
        "dependent"
      ]
    }
  },
  "required": [
    "record_type"
  ],
  "title": "ClaimRecord",
  "type": "object"
}
