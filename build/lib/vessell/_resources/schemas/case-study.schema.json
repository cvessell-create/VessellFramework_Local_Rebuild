{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed local comparative case-study specification",
  "type": "object",
  "required": ["design", "source_document_sha256", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "design": {"const": "RECONSTRUCTED_LOCAL_COMPARISON"},
    "source_document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scenarios": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "claim", "source", "official_record", "uncertainty", "observed_at", "correction", "correction_reason", "corrected_at", "consumers"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "claim": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "official_record": {"type": "boolean"},
          "uncertainty": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "minLength": 1},
          "correction": {"type": "string", "minLength": 1},
          "correction_reason": {"type": "string", "minLength": 1},
          "corrected_at": {"type": "string", "minLength": 1},
          "consumers": {
            "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
          }
        }
      }
    }
  }
}
