{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Organizational Psychology Literature Catalog",
  "type": "object",
  "required": ["catalog_version", "research_question", "records"],
  "properties": {
    "catalog_version": {"const": 1},
    "research_question": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "citation",
        "source_type",
        "source_locator",
        "screening_decision",
        "source_check_status",
        "extraction_basis",
        "population_and_setting",
        "design",
        "constructs",
        "measures",
        "outcomes",
        "findings_summary",
        "limitations",
        "applicability_note",
        "appraisal_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "citation": {"type": "string", "minLength": 1},
        "source_type": {
          "enum": [
            "EMPIRICAL_STUDY",
            "SYSTEMATIC_REVIEW",
            "META_ANALYSIS",
            "GUIDELINE",
            "THEORY_OR_MODEL",
            "OTHER"
          ]
        },
        "source_locator": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["DOI", "URL"]},
            "value": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "DOI"}}, "required": ["kind"]},
              "then": {"properties": {"value": {"pattern": "^10\\.[0-9]{4,9}/\\S+$"}}}
            },
            {
              "if": {"properties": {"kind": {"const": "URL"}}, "required": ["kind"]},
              "then": {"properties": {"value": {"pattern": "^https?://\\S+$"}}}
            }
          ],
          "additionalProperties": false
        },
        "screening_decision": {"enum": ["PENDING", "INCLUDED", "EXCLUDED"]},
        "screening_reason": {"type": "string"},
        "source_check_status": {
          "enum": ["NOT_CHECKED", "CITATION_CHECKED", "FULL_TEXT_CHECKED"]
        },
        "source_check_note": {"type": "string"},
        "extraction_basis": {
          "enum": ["CITATION_ONLY", "ABSTRACT", "FULL_TEXT"]
        },
        "supporting_location": {"type": "string"},
        "population_and_setting": {"type": "string", "minLength": 1},
        "design": {"type": "string", "minLength": 1},
        "constructs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "measures": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "outcomes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "findings_summary": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "applicability_note": {"type": "string", "minLength": 1},
        "appraisal_status": {"enum": ["NOT_APPRAISED", "APPRAISED"]},
        "appraisal_method": {"type": "string"},
        "appraisal_notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"screening_decision": {"const": "EXCLUDED"}},
            "required": ["screening_decision"]
          },
          "then": {"properties": {"screening_reason": {"minLength": 1}}, "required": ["screening_reason"]}
        },
        {
          "if": {
            "properties": {"appraisal_status": {"const": "APPRAISED"}},
            "required": ["appraisal_status"]
          },
          "then": {
            "required": ["appraisal_method", "appraisal_notes"],
            "properties": {
              "appraisal_method": {"minLength": 1},
              "appraisal_notes": {"minLength": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
